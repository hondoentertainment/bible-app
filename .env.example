# Server-side only — never exposed to the browser.

# Bible API (NIV text) — https://scripture.api.bible/signup
BIBLE_API_KEY=your_api_key_here

# Spotify search — https://developer.spotify.com/dashboard
# Create an app and add Client ID + Secret (Client Credentials flow)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Note: Spotify does not provide lyrics via API.
# Lyrics are fetched from LRCLIB (lrclib.net) by artist + track name.
